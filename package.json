{
  "name": "dsh-doubao-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Doubao desktop pet for the DSH web shell: a draggable, resizable mascot with a quota bubble, plus image generation through both the local Doubao work mode and the Volcengine Ark API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afeiaswell/dsh-doubao-pet.git"
  },
  "homepage": "https://github.com/afeiaswell/dsh-doubao-pet#readme",
  "bugs": {
    "url": "https://github.com/afeiaswell/dsh-doubao-pet/issues"
  },
  "author": "afeiaswell",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "doubao",
    "pet",
    "image-generation",
    "ark"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets",
    "docs",
    "tools",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT"
}
